
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id       String   @id @default(uuid())
  roleName String   @unique

  users    User[]
  statuses Status[]

  @@map("roles")
}

model Status {
  id         String @id @default(uuid())
  statusName String
  roleId     String

  role  Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  items Item[]

  @@unique([roleId, statusName])
  @@map("statuses")
}

model Item {
  id          String    @id @default(uuid())
  sapPn       String
  starkeyPn   String
  itemName    String
  mouldNo     String?
  equipmentNo String?
  testing     Boolean   @default(false)
  sapPnAlt    String?
  rm          String?
  materialId  String?
  price       Decimal?  @db.Decimal(12, 2)
  deletedAt   DateTime?
  statusId    String?

  material Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  status   Status?   @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@map("items")
}

model Material {
  id        String   @id @default(uuid())
  name      String   @unique
  items     Item[]
  createdAt DateTime @default(now())

  @@map("materials")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  // Dipertahankan sementara untuk migrasi data lama.
  role   String @default("user")
  roleId String?

  roleRef Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)
}
